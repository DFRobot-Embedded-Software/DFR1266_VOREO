# 16MB Flash + English MultiNet (no Chinese MN). WakeNet off in AFE code;
# keep WN model unset in menuconfig after first configure if listed.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MODEL_IN_FLASH=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
# PeripheralCode I2C 从机用 V2 API（on_receive/on_request/i2c_slave_write）
CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y
# AFE/MultiNet 需要 PSRAM；关闭会导致 SR_RINGBUF Memory exhausted + feed 空指针崩溃
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# MN7+VADNet 与 skainet 示例一致：240MHz，避免 detect 饿死 IDLE1 TWDT
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
